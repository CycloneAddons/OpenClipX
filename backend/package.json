{
  "name": "openclipx-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --no-warnings src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node --no-warnings dist/index.js",
    "test": "tsx --test tests/unit.test.ts tests/downloader.test.ts tests/api.test.ts tests/acceptance_e2e.test.ts",
    "test:unit": "tsx --test tests/unit.test.ts"
  },
  "dependencies": {
    "@google/genai": "^3.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "mime": "^4.1.2",
    "multer": "^2.0.0",
    "openai": "^4.87.3",
    "ytora": "github:CycloneAddons/ytora",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
