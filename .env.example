PORT=4000
NODE_ENV=development
LOG_LEVEL=info
DATA_DIR=./data
MODELS_DIR=./models

# AI API Configuration (OpenAI-compatible)
AI_BASE_URL=https://antigravity-reversed.vercel.app/v1
AI_API_KEY=
AI_MODEL=
AI_VISION_MODEL=

# Gemini TTS Multi-Speaker Dubbing Configuration
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Ultra-Lightweight Memory Optimization (< 1.5 GB RAM target)
MAX_CONCURRENT_JOBS=1
NORMAL_RAM_TARGET_MB=900
PEAK_RAM_BUDGET_MB=1500
EMERGENCY_RAM_CEILING_MB=1700
FFMPEG_THREADS=2
CV_ANALYSIS_WIDTH=640
CV_BASE_FPS=5
CV_BOOST_FPS=12

WHISPER_MODEL=base-q5_1
WHISPER_THREADS=2

# Optional Tool Overrides (defaults to bundled/system binaries)
PYTHON_BIN=
FFMPEG_PATH=
FFPROBE_PATH=
